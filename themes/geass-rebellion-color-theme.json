  "tokenColors": [
    {
      "name": "Comentários",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7D7487", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#C9A8F2" }
    },
    {
      "name": "Números e constantes",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": { "foreground": "#F0BD57" }
    },
    {
      "name": "Palavras-chave e controle",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#F05A82" }
    },
    {
      "name": "Funções",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#E7BC5D" }
    },
    {
      "name": "Tipos e classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "storage.type.class"],
      "settings": { "foreground": "#9FC4F0" }
    },
    {
      "name": "Variáveis e propriedades",
      "scope": ["variable", "variable.other", "support.variable", "meta.object-literal.key"],
      "settings": { "foreground": "#E8E2ED" }
    },
    {
      "name": "Parâmetros",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#DAB8C8", "fontStyle": "italic" }
    },
    {
      "name": "Propriedades",
      "scope": ["variable.other.property", "support.type.property-name", "entity.other.attribute-name"],
      "settings": { "foreground": "#80CEB0" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#EB648B" }
    },
    {
      "name": "Regex e escape",
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": { "foreground": "#7ED3CB" }
    },
    {
      "name": "Operadores",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": { "foreground": "#CE91B6" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#E7BC5D", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#F0D18D", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#CAA7EF", "fontStyle": "italic" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#80CEB0" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FFF5F7", "background": "#A82042" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#9FC4F0",
    "type": "#9FC4F0",
    "class": { "foreground": "#9FC4F0", "fontStyle": "bold" },
    "enum": "#A7CBEF",
    "interface": "#80CEB0",
    "struct": "#9FC4F0",
    "typeParameter": "#A7D8D3",
    "parameter": { "foreground": "#DAB8C8", "fontStyle": "italic" },
    "variable": "#E8E2ED",
    "property": "#80CEB0",
    "enumMember": "#F0BD57",
    "function": "#E7BC5D",
    "method": "#E7BC5D",
    "macro": "#F05A82",
    "keyword": "#F05A82",
    "modifier": "#E97B9A",
    "comment": { "foreground": "#7D7487", "fontStyle": "italic" },
    "string": "#C9A8F2",
    "number": "#F0BD57",
    "regexp": "#7ED3CB",
    "operator": "#CE91B6",
    "decorator": "#BDA5F0"
  }
}
