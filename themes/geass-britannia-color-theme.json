  "tokenColors": [
    {
      "name": "Comentários",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#817681", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#67458F" }
    },
    {
      "name": "Números e constantes",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": { "foreground": "#8B6008" }
    },
    {
      "name": "Palavras-chave e controle",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#A51F4B" }
    },
    {
      "name": "Funções",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#75520A" }
    },
    {
      "name": "Tipos e classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "storage.type.class"],
      "settings": { "foreground": "#315F91" }
    },
    {
      "name": "Variáveis e propriedades",
      "scope": ["variable", "variable.other", "support.variable", "meta.object-literal.key"],
      "settings": { "foreground": "#342D38" }
    },
    {
      "name": "Parâmetros",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#6E4258", "fontStyle": "italic" }
    },
    {
      "name": "Propriedades",
      "scope": ["variable.other.property", "support.type.property-name", "entity.other.attribute-name"],
      "settings": { "foreground": "#24705B" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#A7224D" }
    },
    {
      "name": "Regex e escape",
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": { "foreground": "#1D7476" }
    },
    {
      "name": "Operadores",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": { "foreground": "#854268" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#77520A", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#634204", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#67458F", "fontStyle": "italic" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#24705B" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FFFFFF", "background": "#B32043" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#315F91",
    "type": "#315F91",
    "class": { "foreground": "#315F91", "fontStyle": "bold" },
    "enum": "#315F91",
    "interface": "#24705B",
    "struct": "#315F91",
    "typeParameter": "#276D72",
    "parameter": { "foreground": "#6E4258", "fontStyle": "italic" },
    "variable": "#342D38",
    "property": "#24705B",
    "enumMember": "#8B6008",
    "function": "#75520A",
    "method": "#75520A",
    "macro": "#A51F4B",
    "keyword": "#A51F4B",
    "modifier": "#9A3457",
    "comment": { "foreground": "#817681", "fontStyle": "italic" },
    "string": "#67458F",
    "number": "#8B6008",
    "regexp": "#1D7476",
    "operator": "#854268",
    "decorator": "#71509A"
  }
}
