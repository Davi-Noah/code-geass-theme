    "peekViewResult.background": "#101419",
    "peekViewTitle.background": "#20262D",
    "panel.background": "#14181D",
    "panel.border": "#343C46",
    "statusBar.noFolderBackground": "#2B333D",
    "titleBar.activeBackground": "#090B0E",
    "titleBar.inactiveBackground": "#090B0E",
    "terminal.background": "#090B0E",
    "terminal.ansiBlack": "#20262D",
    "notifications.background": "#20262D",
    "notifications.border": "#343C46"
