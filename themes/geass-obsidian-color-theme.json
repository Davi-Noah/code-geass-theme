{
  "$schema": "vscode://schemas/color-theme",
  "name": "Geass Requiem: Obsidian",
  "include": "./geass-rebellion-color-theme.json",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "textBlockQuote.background": "#14181D",
    "textCodeBlock.background": "#14181D",
    "button.secondaryBackground": "#2B333D",
    "button.secondaryHoverBackground": "#343C46",
    "checkbox.background": "#14181D",
    "checkbox.border": "#46505C",
    "dropdown.background": "#14181D",
    "dropdown.border": "#343C46",
    "input.background": "#14181D",
    "input.border": "#343C46",
    "scrollbar.shadow": "#050609",
    "list.hoverBackground": "#20262D",
    "list.inactiveSelectionBackground": "#252C34",
    "activityBar.background": "#090B0E",
    "sideBar.background": "#14181D",
    "sideBar.border": "#343C46",
    "sideBarSectionHeader.background": "#20262D",
    "minimap.background": "#090B0E",
    "editorGroupHeader.tabsBackground": "#090B0E",
